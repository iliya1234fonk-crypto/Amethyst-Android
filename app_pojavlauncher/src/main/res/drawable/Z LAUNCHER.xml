<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_z_gradient" />
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:left="-120dp"
        android:top="-100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="180dp"
                android:startColor="#AA8B5CF6" android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="bottom|end"
        android:right="-120dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="160dp"
                android:startColor="#88EC4899" android:endColor="#00EC4899" />
        </shape>
    </item>
    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="center_vertical|start"
        android:left="-90dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp"
                android:startColor="#6622D3EE" android:endColor="#0022D3EE" />
        </shape>
    </item>
</layer-list>
