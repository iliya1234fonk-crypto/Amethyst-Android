<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#3AFFFFFF"
                        android:endColor="#10FFFFFF" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#4DFFFFFF" />
                </shape>
            </item>
            <item
                android:height="26dp"
                android:gravity="top"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="21dp"
                        android:topRightRadius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
